<?xml version="1.0" encoding="UTF-8"?>
<interface>
  <requires lib="gtk" version="4.0"/>
  <requires lib="Adw" version="1.0"/>
  <template class="NumoSettingsWindow" parent="AdwPreferencesDialog">
    <property name="title" translatable="yes">Settings</property>
    <property name="content-width">650</property>
    <property name="content-height">750</property>
    <property name="search-enabled">False</property>
    <child>
      <object class="AdwPreferencesPage">
        <child>
          <object class="AdwPreferencesGroup">
            <property name="title" translatable="yes">General</property>
            <child>
              <object class="AdwComboRow" id="difficulty_row">
                <property name="title" translatable="yes">Default Difficulty</property>
                <property name="model">
                  <object class="GtkStringList">
                    <items>
                      <item translatable="yes">Easy</item>
                      <item translatable="yes">Medium</item>
                      <item translatable="yes">Hard</item>
                    </items>
                  </object>
                </property>
              </object>
            </child>
          </object>
        </child>
        <child>
          <object class="AdwPreferencesGroup">
            <property name="title" translatable="yes">Timer Mode</property>
            <child>
              <object class="AdwSpinRow" id="timer_minutes_row">
                <property name="title" translatable="yes">Duration</property>
                <property name="subtitle" translatable="yes">Minutes</property>
                <property name="adjustment">
                  <object class="GtkAdjustment">
                    <property name="lower">1</property>
                    <property name="upper">10</property>
                    <property name="step-increment">1</property>
                    <property name="page-increment">1</property>
                    <property name="value">3</property>
                  </object>
                </property>
              </object>
            </child>
          </object>
        </child>
        <child>
          <object class="AdwPreferencesGroup">
            <property name="title" translatable="yes">Timer + Bonus Mode</property>
            <child>
              <object class="AdwSpinRow" id="bonus_start_row">
                <property name="title" translatable="yes">Initial time</property>
                <property name="subtitle" translatable="yes">Seconds</property>
                <property name="adjustment">
                  <object class="GtkAdjustment">
                    <property name="lower">30</property>
                    <property name="upper">600</property>
                    <property name="step-increment">10</property>
                    <property name="value">60</property>
                  </object>
                </property>
              </object>
            </child>
            <child>
              <object class="AdwSpinRow" id="bonus_seconds_row">
                <property name="title" translatable="yes">Bonus per correct answer</property>
                <property name="subtitle" translatable="yes">Seconds</property>
                <property name="adjustment">
                  <object class="GtkAdjustment">
                    <property name="lower">1</property>
                    <property name="upper">10</property>
                    <property name="step-increment">1</property>
                    <property name="value">3</property>
                  </object>
                </property>
              </object>
            </child>
          </object>
        </child>
        <child>
          <object class="AdwPreferencesGroup">
            <property name="title" translatable="yes">Task Count Mode</property>
            <child>
              <object class="AdwSpinRow" id="tasks_count_row">
                <property name="title" translatable="yes">Number of tasks</property>
                <property name="adjustment">
                  <object class="GtkAdjustment">
                    <property name="lower">1</property>
                    <property name="upper">100</property>
                    <property name="step-increment">1</property>
                    <property name="value">10</property>
                  </object>
                </property>
              </object>
            </child>
          </object>
        </child>
        <child>
          <object class="AdwPreferencesGroup">
            <property name="title" translatable="yes">Statistics</property>
            <child>
              <object class="AdwSpinRow" id="recent_sessions_row">
                <property name="title" translatable="yes">Number of recent sessions</property>
                <property name="adjustment">
                  <object class="GtkAdjustment">
                    <property name="lower">1</property>
                    <property name="upper">25</property>
                    <property name="step-increment">1</property>
                    <property name="value">10</property>
                  </object>
                </property>
              </object>
            </child>
          </object>
        </child>



        <child>
          <object class="AdwPreferencesGroup">
            <property name="title" translatable="yes">Custom difficulty</property>
            <property name="description" translatable="yes">Choose operations and set number ranges to create your own math challenge</property>
            <child type="header-suffix">
              <object class="GtkButton" id="custom_help_button">
                <property name="icon-name">info-outline-symbolic</property>
                <property name="valign">center</property>
                <style>
                  <class name="flat"/>
                  <class name="circular"/>
                  <class name="dim-label"/>
                  <class name="info-icon"/>
                </style>
              </object>
            </child>
            <child>
              <object class="AdwExpanderRow" id="custom_add">
                <property name="title" translatable="yes">Addition</property>
                <property name="show-enable-switch">True</property>
                <property name="enable-expansion">False</property>
                <child type="suffix">
                  <object class="GtkLabel">
                    <property name="label">+</property>
                    <style>
                      <class name="title-4"/>
                      <class name="dim-label"/>
                    </style>
                  </object>
                </child>
                <child>
                  <object class="AdwSpinRow" id="custom_add_min">
                    <property name="title" translatable="yes">Minimum number</property>
                    <property name="adjustment">
                      <object class="GtkAdjustment">
                        <property name="lower">-5000</property>
                        <property name="upper">5000</property>
                        <property name="step-increment">1</property>
                        <property name="page-increment">100</property>
                        <property name="value">-5000</property>
                      </object>
                    </property>
                  </object>
                </child>
                <child>
                  <object class="AdwSpinRow" id="custom_add_max">
                    <property name="title" translatable="yes">Maximum number</property>
                    <property name="adjustment">
                      <object class="GtkAdjustment">
                        <property name="lower">-5000</property>
                        <property name="upper">5000</property>
                        <property name="step-increment">1</property>
                        <property name="page-increment">100</property>
                        <property name="value">5000</property>
                      </object>
                    </property>
                  </object>
                </child>
              </object>
            </child>

            <child>
              <object class="AdwExpanderRow" id="custom_sub">
                <property name="title" translatable="yes">Subtraction</property>
                <property name="show-enable-switch">True</property>
                <property name="enable-expansion">False</property>
                <child type="suffix">
                  <object class="GtkLabel">
                    <property name="label">−</property>
                    <style>
                      <class name="title-4"/>
                      <class name="dim-label"/>
                    </style>
                  </object>
                </child>
                <child>
                  <object class="AdwSpinRow" id="custom_sub_min">
                    <property name="title" translatable="yes">Minimum number</property>
                    <property name="adjustment">
                      <object class="GtkAdjustment">
                        <property name="lower">-5000</property>
                        <property name="upper">5000</property>
                        <property name="step-increment">1</property>
                        <property name="page-increment">100</property>
                        <property name="value">-5000</property>
                      </object>
                    </property>
                  </object>
                </child>
                <child>
                  <object class="AdwSpinRow" id="custom_sub_max">
                    <property name="title" translatable="yes">Maximum number</property>
                    <property name="adjustment">
                      <object class="GtkAdjustment">
                        <property name="lower">-5000</property>
                        <property name="upper">5000</property>
                        <property name="step-increment">1</property>
                        <property name="page-increment">100</property>
                        <property name="value">5000</property>
                      </object>
                    </property>
                  </object>
                </child>
                <child>
                  <object class="AdwSwitchRow" id="custom_sub_non_negative">
                    <property name="title" translatable="yes">Result is not negative</property>
                    <property name="subtitle" translatable="yes">Only for fully positive ranges</property>
                    <property name="active">False</property>
                  </object>
                </child>
              </object>
            </child>

            <child>
              <object class="AdwExpanderRow" id="custom_mul">
                <property name="title" translatable="yes">Multiplication</property>
                <property name="show-enable-switch">True</property>
                <property name="enable-expansion">False</property>
                <child type="suffix">
                  <object class="GtkLabel">
                    <property name="label">×</property>
                    <style>
                      <class name="title-4"/>
                      <class name="dim-label"/>
                    </style>
                  </object>
                </child>
                <child>
                  <object class="AdwSpinRow" id="custom_mul_min">
                    <property name="title" translatable="yes">Minimum number</property>
                    <property name="adjustment">
                      <object class="GtkAdjustment">
                        <property name="lower">-100</property>
                        <property name="upper">100</property>
                        <property name="step-increment">1</property>
                        <property name="page-increment">10</property>
                        <property name="value">-100</property>
                      </object>
                    </property>
                  </object>
                </child>
                <child>
                  <object class="AdwSpinRow" id="custom_mul_max">
                    <property name="title" translatable="yes">Maximum number</property>
                    <property name="adjustment">
                      <object class="GtkAdjustment">
                        <property name="lower">-100</property>
                        <property name="upper">100</property>
                        <property name="step-increment">1</property>
                        <property name="page-increment">10</property>
                        <property name="value">100</property>
                      </object>
                    </property>
                  </object>
                </child>
              </object>
            </child>

            <child>
              <object class="AdwExpanderRow" id="custom_div">
                <property name="title" translatable="yes">Division</property>
                <property name="show-enable-switch">True</property>
                <property name="enable-expansion">False</property>
                <child type="suffix">
                  <object class="GtkLabel">
                    <property name="label">÷</property>
                    <style>
                      <class name="title-4"/>
                      <class name="dim-label"/>
                    </style>
                  </object>
                </child>
                <child>
                  <object class="AdwSpinRow" id="custom_div_min">
                    <property name="title" translatable="yes">Minimum number</property>
                    <property name="adjustment">
                      <object class="GtkAdjustment">
                        <property name="lower">-100</property>
                        <property name="upper">100</property>
                        <property name="step-increment">1</property>
                        <property name="page-increment">10</property>
                        <property name="value">-100</property>
                      </object>
                    </property>
                  </object>
                </child>
                <child>
                  <object class="AdwSpinRow" id="custom_div_max">
                    <property name="title" translatable="yes">Maximum number</property>
                    <property name="adjustment">
                      <object class="GtkAdjustment">
                        <property name="lower">-100</property>
                        <property name="upper">100</property>
                        <property name="step-increment">1</property>
                        <property name="page-increment">10</property>
                        <property name="value">100</property>
                      </object>
                    </property>
                  </object>
                </child>
              </object>
            </child>

            <child>
              <object class="AdwExpanderRow" id="custom_intdiv">
                <property name="title" translatable="yes">Integer Division</property>
                <property name="show-enable-switch">True</property>
                <property name="enable-expansion">False</property>
                <child type="suffix">
                  <object class="GtkLabel">
                    <property name="label">div</property>
                    <style>
                      <class name="dim-label"/>
                    </style>
                  </object>
                </child>
                <child>
                  <object class="AdwSpinRow" id="custom_intdiv_min">
                    <property name="title" translatable="yes">Minimum number</property>
                    <property name="adjustment">
                      <object class="GtkAdjustment">
                        <property name="lower">1</property>
                        <property name="upper">100</property>
                        <property name="step-increment">1</property>
                        <property name="page-increment">10</property>
                        <property name="value">1</property>
                      </object>
                    </property>
                  </object>
                </child>
                <child>
                  <object class="AdwSpinRow" id="custom_intdiv_max">
                    <property name="title" translatable="yes">Maximum number</property>
                    <property name="adjustment">
                      <object class="GtkAdjustment">
                        <property name="lower">1</property>
                        <property name="upper">100</property>
                        <property name="step-increment">1</property>
                        <property name="page-increment">10</property>
                        <property name="value">100</property>
                      </object>
                    </property>
                  </object>
                </child>
              </object>
            </child>

            <child>
              <object class="AdwExpanderRow" id="custom_mod">
                <property name="title" translatable="yes">Modulo</property>
                <property name="show-enable-switch">True</property>
                <property name="enable-expansion">False</property>
                <child type="suffix">
                  <object class="GtkLabel">
                    <property name="label">mod</property>
                    <style>
                      <class name="dim-label"/>
                    </style>
                  </object>
                </child>
                <child>
                  <object class="AdwSpinRow" id="custom_mod_min">
                    <property name="title" translatable="yes">Minimum number</property>
                    <property name="adjustment">
                      <object class="GtkAdjustment">
                        <property name="lower">1</property>
                        <property name="upper">100</property>
                        <property name="step-increment">1</property>
                        <property name="page-increment">10</property>
                        <property name="value">1</property>
                      </object>
                    </property>
                  </object>
                </child>
                <child>
                  <object class="AdwSpinRow" id="custom_mod_max">
                    <property name="title" translatable="yes">Maximum number</property>
                    <property name="adjustment">
                      <object class="GtkAdjustment">
                        <property name="lower">1</property>
                        <property name="upper">100</property>
                        <property name="step-increment">1</property>
                        <property name="page-increment">10</property>
                        <property name="value">100</property>
                      </object>
                    </property>
                  </object>
                </child>
              </object>
            </child>
          </object>
        </child>
        <child>
          <object class="AdwPreferencesGroup">
            <child>
              <object class="AdwButtonRow" id="custom_reset_row">
                <property name="title" translatable="yes">Reset to default</property>
                <property name="start-icon-name">edit-undo-symbolic</property>
              </object>
            </child>
          </object>
        </child>



      </object>
    </child>
  </template>
</interface>
