    </release>

    <release version="0.1" date="2026-10-04">
      <description translate="no">
        <p>First public release.</p>
        <ul>
          <li>Four game modes</li>
          <li>Three difficulty levels</li>
          <li>Session statistics with export and import</li>
        </ul>
      </description>
    </release>

  </releases>

