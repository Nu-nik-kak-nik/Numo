<?xml version="1.0" encoding="UTF-8"?>
<component type="desktop-application">
  <id>io.github.Nu_nik_kak_nik.Numo</id>
  <metadata_license>CC0-1.0</metadata_license>
  <project_license>GPL-3.0-or-later</project_license>

  <name>Numo</name>
  <summary>Fast mental math training</summary>
  <description>
    <p>
      Numo is a small app for training mental arithmetic. It generates
      tasks on the fly and checks your answers instantly.
    </p>
    <p>Four modes are available:</p>
    <ul>
      <li>Normal — solve until you make a mistake</li>
      <li>Timer — solve as many as possible in a fixed time</li>
      <li>Timer + Bonus — earn extra seconds for correct answers</li>
      <li>Task Count — solve a fixed number of tasks</li>
    </ul>
    <p>
      Three difficulty levels let you start simple and work up to
      negative numbers, division, and modulo.
    </p>
  </description>

  <developer id="io.github.Nu_nik_kak_nik">
    <name>Nu-nik-kak-nik</name>
  </developer>


  <url type="homepage">https://github.com/Nu-nik-kak-nik/Numo</url>
