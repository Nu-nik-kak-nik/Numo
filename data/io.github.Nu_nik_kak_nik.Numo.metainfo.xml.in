<?xml version="1.0" encoding="UTF-8"?>
<component type="desktop-application">
  <id>io.github.Nu_nik_kak_nik.Numo</id>
  <metadata_license>CC0-1.0</metadata_license>
  <project_license>GPL-3.0-or-later</project_license>

  <name>Numo</name>
  <summary>Fast mental math training</summary>
  <description>
    <p>
      Numo is a lightweight app for sharpening mental arithmetic.
      It generates tasks on the fly and checks your answers the moment
      you press Enter — no menus, just numbers.
    </p>

    <p>Pick one of four modes depending on what you want to train:</p>
    <ul>
      <li>
        <b>Normal</b>: an endless run of tasks that ends the moment
        you make a mistake. A test of focus and consistency.
      </li>
      <li>
        <b>Timer</b>: a fixed countdown. Solve as many tasks as you can
        before time runs out.
      </li>
      <li>
        <b>Timer + Bonus</b>: start with a small amount of time and
        earn extra seconds for every correct answer.
      </li>
      <li>
        <b>Task Count</b>: a set number of tasks to solve. A clear goal to
        reach at your own pace.
      </li>
    </ul>

    <p>
      Three difficulty levels let you start simple and work your way up.
      Easy is just addition and subtraction. Medium adds multiplication
      and exact division. Hard goes into negative numbers, floor div,
      and mod.
    </p>

    <p>
      Every session is recorded: results, accuracy, and time spent.
      The statistics screen shows your best results per mode and
      difficulty, recent games, and overall progress, and you can export
      or import your data at any time.
    </p>

    <p>
      Numo is designed to stay out of your way. Big readable tasks,
      an unobtrusive interface, and a focus on the numbers themselves.
    </p>
  </description>

  <developer id="io.github.Nu_nik_kak_nik">
